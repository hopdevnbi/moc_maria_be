                "name": "ZALO_THANH_THANH_BOT_TOKEN",
                "valueFrom": {
                  "secretKeyRef": { "name": "moc-maria-zalo-thanh-thanh", "key": "token" }
                }
              },
              {
                "name": "ZALO_THANH_THANH_PROVIDER_ID",
