{
    "apiVersion":  "batch/v1",
    "kind":  "Job",
    "metadata":  {
                     "name":  "moc-maria-zalo-metadata-private-20261119",
                     "namespace":  "moc-maria"
                 },
    "spec":  {
                 "backoffLimit":  0,
                 "activeDeadlineSeconds":  180,
                 "ttlSecondsAfterFinished":  86400,
                 "template":  {
                                  "spec":  {
                                               "dnsConfig":  {
                                                                 "options":  [
                                                                                 {
                                                                                     "name":  "ndots",
                                                                                     "value":  "1"
                                                                                 }
                                                                             ]
                                                             },
                                               "restartPolicy":  "Never",
                                               "containers":  [
                                                                  {
                                                                      "name":  "migrate",
                                                                      "image":  "ghcr.io/hopdevnbi/moc_maria_be@sha256:e4369f7c6ef25c1c3a4b712d3056381fbf5d4de05a8eff9ad3afc32c2ce21533",
                                                                      "command":  [
                                                                                      "node",
                                                                                      "-e"
                                                                                  ],
                                                                      "args":  [
                                                                                   "const ds=require(\u0027./dist/database/data-source\u0027).default;\nconst expected=\u0027AppMetadataPrivate1795075200000\u0027;\n(async()=\u003e{\n await ds.initialize();\n const before=await ds.query(\u0027SELECT name FROM migrations ORDER BY id\u0027);\n const available=ds.migrations.map(m=\u003em.name||m.constructor.name);\n const names=before.map(m=\u003em.name);\n if(available.length!==35||new Set(available).size!==35||!available.includes(expected)||![34,35].includes(names.length)||new Set(names).size!==names.length||names.some(n=\u003e!available.includes(n)))throw Error(\u0027UNEXPECTED_SCHEMA_STATE\u0027);\n const pending=available.filter(n=\u003e!names.includes(n));\n if(pending.length!==(names.length===34?1:0)||pending.some(n=\u003en!==expected))throw Error(\u0027UNEXPECTED_PENDING_MIGRATION\u0027);\n const runner=ds.createQueryRunner();try{const client=await runner.connect();const socket=client.connection.stream;if(!socket?.encrypted||!socket.authorized)throw Error(\u0027CLIENT_TLS_UNVERIFIED\u0027)}finally{await runner.release()}\n const [pre]=await ds.query(\"SELECT current_user=pg_get_userbyid(c.relowner) AS owner,r.rolbypassrls OR r.rolsuper AS bypass,NOT c.relforcerowsecurity AS noforce FROM pg_class c JOIN pg_roles r ON r.rolname=current_user WHERE c.oid=\u0027public.app_metadata\u0027::regclass\");\n if(!pre||!(pre.owner\u0026\u0026pre.noforce||pre.bypass))throw Error(\u0027RUNTIME_RLS_ACCESS_UNVERIFIED\u0027);\n const applied=await ds.runMigrations({transaction:\u0027all\u0027});\n const after=await ds.query(\u0027SELECT name FROM migrations ORDER BY id\u0027);\n const [verified]=await ds.query(\"SELECT relrowsecurity AS rls,has_table_privilege(\u0027anon\u0027,oid,\u0027SELECT,INSERT,UPDATE,DELETE,TRUNCATE,REFERENCES,TRIGGER\u0027) AS anon,has_table_privilege(\u0027authenticated\u0027,oid,\u0027SELECT,INSERT,UPDATE,DELETE,TRUNCATE,REFERENCES,TRIGGER\u0027) AS authenticated FROM pg_class WHERE oid=\u0027public.app_metadata\u0027::regclass\");\n if(after.length!==35||!after.some(m=\u003em.name===expected)||!verified?.rls||verified.anon||verified.authenticated)throw Error(\u0027VERIFY_FAILED\u0027);\n await ds.query(\"SELECT 1 FROM public.app_metadata LIMIT 1\");\n console.log(JSON.stringify({before:before.length,after:after.length,applied:applied.map(m=\u003em.name),tls:true,verified}));\n})().catch(e=\u003e{console.error(JSON.stringify({error:e.code||e.message}));process.exitCode=1}).finally(async()=\u003e{if(ds.isInitialized)await ds.destroy()});"
                                                                               ],
                                                                      "env":  [
                                                                                  {
                                                                                      "name":  "NODE_EXTRA_CA_CERTS",
                                                                                      "value":  "/etc/moc-maria-ca/supabase.crt"
                                                                                  },
                                                                                  {
                                                                                      "name":  "DATABASE_SSL",
                                                                                      "value":  "true"
                                                                                  },
                                                                                  {
                                                                                      "name":  "DATABASE_SSL_REJECT_UNAUTHORIZED",
                                                                                      "value":  "true"
                                                                                  },
                                                                                  {
                                                                                      "name":  "DATABASE_POOL_MAX",
                                                                                      "value":  "1"
                                                                                  },
                                                                                  {
                                                                                      "name":  "DATABASE_URL",
                                                                                      "valueFrom":  {
                                                                                                        "secretKeyRef":  {
                                                                                                                             "name":  "moc-maria-api-secrets",
                                                                                                                             "key":  "DATABASE_URL"
                                                                                                                         }
                                                                                                    }
                                                                                  }
                                                                              ],
                                                                      "volumeMounts":  [
                                                                                           {
                                                                                               "name":  "database-ca",
                                                                                               "mountPath":  "/etc/moc-maria-ca",
                                                                                               "readOnly":  true
                                                                                           }
                                                                                       ],
                                                                      "resources":  {
                                                                                        "requests":  {
                                                                                                         "cpu":  "50m",
                                                                                                         "memory":  "128Mi"
                                                                                                     },
                                                                                        "limits":  {
                                                                                                       "cpu":  "300m",
                                                                                                       "memory":  "256Mi"
                                                                                                   }
                                                                                    },
                                                                      "securityContext":  {
                                                                                              "runAsNonRoot":  true,
                                                                                              "runAsUser":  1000,
                                                                                              "runAsGroup":  1000,
                                                                                              "allowPrivilegeEscalation":  false,
                                                                                              "capabilities":  {
                                                                                                                   "drop":  [
                                                                                                                                "ALL"
                                                                                                                            ]
                                                                                                               },
                                                                                              "seccompProfile":  {
                                                                                                                     "type":  "RuntimeDefault"
                                                                                                                 }
                                                                                          }
                                                                  }
                                                              ],
                                               "volumes":  [
                                                               {
                                                                   "name":  "database-ca",
                                                                   "configMap":  {
                                                                                     "name":  "moc-maria-database-ca"
                                                                                 }
                                                               }
                                                           ]
                                           }
                              }
             }
}
