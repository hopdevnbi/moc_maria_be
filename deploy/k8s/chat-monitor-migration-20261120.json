{
    "apiVersion":  "batch/v1",
    "kind":  "Job",
    "metadata":  {
                     "name":  "moc-maria-chat-monitor-20261120",
                     "namespace":  "moc-maria"
                 },
    "spec":  {
                 "backoffLimit":  0,
                 "activeDeadlineSeconds":  180,
                 "ttlSecondsAfterFinished":  86400,
                 "template":  {
                                  "spec":  {
                                               "dnsConfig":  {
                                                                 "options":  [
                                                                                 {
                                                                                     "name":  "ndots",
                                                                                     "value":  "1"
                                                                                 }
                                                                             ]
                                                             },
                                               "restartPolicy":  "Never",
                                               "containers":  [
                                                                  {
                                                                      "name":  "migrate",
                                                                      "image":  "ghcr.io/hopdevnbi/moc_maria_be@sha256:889eaf25f3bba99de4fbda02edf6f377535109da0bbd0ceec1fe225768770ea1",
                                                                      "command":  [
                                                                                      "node",
                                                                                      "-e"
                                                                                  ],
                                                                      "args":  [
                                                                                   "const ds=require(\u0027./dist/database/data-source\u0027).default;\nconst expected=\u0027PrivateChatMonitor1795078800000\u0027;\nconst tables=[\u0027ktv_chat_threads\u0027,\u0027ktv_chat_messages\u0027,\u0027ktv_chat_blocks\u0027,\u0027audit_logs\u0027,\u0027users\u0027,\u0027roles\u0027,\u0027permissions\u0027,\u0027user_roles\u0027,\u0027role_permissions\u0027,\u0027refresh_sessions\u0027,\u0027password_reset_tokens\u0027];\n(async()=\u003e{\n await ds.initialize();\n const before=await ds.query(\u0027SELECT name FROM migrations ORDER BY id\u0027);\n const available=ds.migrations.map(m=\u003em.name||m.constructor.name);\n const names=before.map(m=\u003em.name);\n if(available.length!==36||new Set(available).size!==36||!available.includes(expected)||![35,36].includes(names.length)||new Set(names).size!==names.length||names.some(n=\u003e!available.includes(n)))throw Error(\u0027UNEXPECTED_SCHEMA_STATE\u0027);\n const pending=available.filter(n=\u003e!names.includes(n));\n if(pending.length!==(names.length===35?1:0)||pending.some(n=\u003en!==expected))throw Error(\u0027UNEXPECTED_PENDING_MIGRATION\u0027);\n const runner=ds.createQueryRunner();try{const client=await runner.connect();const socket=client.connection.stream;if(!socket?.encrypted||!socket.authorized)throw Error(\u0027CLIENT_TLS_UNVERIFIED\u0027)}finally{await runner.release()}\n const pre=await ds.query(\"SELECT c.relname,current_user=pg_get_userbyid(c.relowner) AS owner,c.relforcerowsecurity AS force_rls,(SELECT count(DISTINCT v.oid)::int FROM pg_depend d JOIN pg_rewrite rw ON rw.oid=d.objid JOIN pg_class v ON v.oid=rw.ev_class AND v.relkind IN (\u0027v\u0027,\u0027m\u0027) WHERE d.refobjid=c.oid) AS dependent_views FROM pg_class c WHERE c.relnamespace=\u0027public\u0027::regnamespace AND c.relname=ANY($1::text[])\",[tables]);\n if(pre.length!==11||pre.some(x=\u003e!x.owner||x.force_rls||x.dependent_views!==0))throw Error(\u0027RUNTIME_ACCESS_UNVERIFIED\u0027);\n const applied=await ds.runMigrations({transaction:\u0027all\u0027});\n const after=await ds.query(\u0027SELECT name FROM migrations ORDER BY id\u0027);\n const verified=await ds.query(\"SELECT relname,relrowsecurity AS rls,has_table_privilege(\u0027anon\u0027,oid,\u0027SELECT,INSERT,UPDATE,DELETE,TRUNCATE,REFERENCES,TRIGGER\u0027) AS anon,has_table_privilege(\u0027authenticated\u0027,oid,\u0027SELECT,INSERT,UPDATE,DELETE,TRUNCATE,REFERENCES,TRIGGER\u0027) AS authenticated FROM pg_class WHERE relnamespace=\u0027public\u0027::regnamespace AND relname=ANY($1::text[])\",[tables]);\n if(after.length!==36||!after.some(m=\u003em.name===expected)||verified.length!==11||verified.some(x=\u003e!x.rls||x.anon||x.authenticated))throw Error(\u0027VERIFY_FAILED\u0027);\n for(const table of tables)await ds.query(\u0027SELECT 1 FROM public.\u0027+table+\u0027 LIMIT 1\u0027);\n console.log(JSON.stringify({before:before.length,after:after.length,applied:applied.map(m=\u003em.name),tls:true,tables:verified}));\n})().catch(e=\u003e{console.error(JSON.stringify({error:e.code||e.message}));process.exitCode=1}).finally(async()=\u003e{if(ds.isInitialized)await ds.destroy()});"
                                                                               ],
                                                                      "env":  [
                                                                                  {
                                                                                      "name":  "NODE_EXTRA_CA_CERTS",
                                                                                      "value":  "/etc/moc-maria-ca/supabase.crt"
                                                                                  },
                                                                                  {
                                                                                      "name":  "DATABASE_SSL",
                                                                                      "value":  "true"
                                                                                  },
                                                                                  {
                                                                                      "name":  "DATABASE_SSL_REJECT_UNAUTHORIZED",
                                                                                      "value":  "true"
                                                                                  },
                                                                                  {
                                                                                      "name":  "DATABASE_POOL_MAX",
                                                                                      "value":  "1"
                                                                                  },
                                                                                  {
                                                                                      "name":  "DATABASE_URL",
                                                                                      "valueFrom":  {
                                                                                                        "secretKeyRef":  {
                                                                                                                             "name":  "moc-maria-api-secrets",
                                                                                                                             "key":  "DATABASE_URL"
                                                                                                                         }
                                                                                                    }
                                                                                  }
                                                                              ],
                                                                      "volumeMounts":  [
                                                                                           {
                                                                                               "name":  "database-ca",
                                                                                               "mountPath":  "/etc/moc-maria-ca",
                                                                                               "readOnly":  true
                                                                                           }
                                                                                       ],
                                                                      "resources":  {
                                                                                        "requests":  {
                                                                                                         "cpu":  "50m",
                                                                                                         "memory":  "128Mi"
                                                                                                     },
                                                                                        "limits":  {
                                                                                                       "cpu":  "300m",
                                                                                                       "memory":  "256Mi"
                                                                                                   }
                                                                                    },
                                                                      "securityContext":  {
                                                                                              "runAsNonRoot":  true,
                                                                                              "runAsUser":  1000,
                                                                                              "runAsGroup":  1000,
                                                                                              "allowPrivilegeEscalation":  false,
                                                                                              "capabilities":  {
                                                                                                                   "drop":  [
                                                                                                                                "ALL"
                                                                                                                            ]
                                                                                                               },
                                                                                              "seccompProfile":  {
                                                                                                                     "type":  "RuntimeDefault"
                                                                                                                 }
                                                                                          }
                                                                  }
                                                              ],
                                               "volumes":  [
                                                               {
                                                                   "name":  "database-ca",
                                                                   "configMap":  {
                                                                                     "name":  "moc-maria-database-ca"
                                                                                 }
                                                               }
                                                           ]
                                           }
                              }
             }
}
