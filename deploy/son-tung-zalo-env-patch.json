{
  "spec": {
    "template": {
      "spec": {
        "containers": [
          {
            "name": "api",
            "env": [
              {
                "name": "ZALO_TUNG_BOT_TOKEN",
                "valueFrom": { "secretKeyRef": { "name": "moc-maria-zalo-tung", "key": "token" } }
              },
              {
                "name": "ZALO_TUNG_PROVIDER_ID",
                "valueFrom": {
                  "secretKeyRef": { "name": "moc-maria-zalo-tung", "key": "provider-id" }
                }
              },
              {
                "name": "ZALO_TUNG_CHAT_IDS",
                "valueFrom": {
                  "secretKeyRef": { "name": "moc-maria-zalo-tung", "key": "chat-ids" }
                }
              },
              {
                "name": "ZALO_TUNG_WEBHOOK_SECRET",
                "valueFrom": {
                  "secretKeyRef": { "name": "moc-maria-zalo-tung", "key": "webhook-secret" }
                }
              }
            ]
          }
        ]
      }
    }
  }
}
