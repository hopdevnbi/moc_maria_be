NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3001
SWAGGER_ENABLED=true

# Runtime connection. Prefer Session Pooler when the runtime network is IPv4-only.
DATABASE_URL=
# Migration connection. Prefer Supabase Direct Connection when IPv6 is available.
DATABASE_MIGRATION_URL=

DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10

APP_ID=MOC_MARIA
CHAT_TENANT=MOC_MARIA
QUEUE_SOURCE=MOC_MARIA
CHAT_SERVICE_URL=
QUEUE_SERVICE_URL=
