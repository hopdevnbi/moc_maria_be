NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3001
SWAGGER_ENABLED=true

# Runtime connection. Prefer Session Pooler when the runtime network is IPv4-only.
DATABASE_URL=
# Migration connection. Prefer Direct Connection only when IPv6 is available.
DATABASE_MIGRATION_URL=

DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10

JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_SESSION_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_DOMAIN=

APP_ID=MOC_MARIA
CHAT_TENANT=MOC_MARIA
QUEUE_SOURCE=MOC_MARIA
CHAT_SERVICE_URL=
MOC_MARIA_CHAT_RELAY_KEY=
# Generate the stable VAPID keypair using: npx web-push generate-vapid-keys --json
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
QUEUE_SERVICE_URL=
# One-time local/operator bootstrap; never commit real values.
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
BOOTSTRAP_SUPER_ADMIN_NAME=
# Optional server-only Zalo admin alerts. Never expose these in NEXT_PUBLIC variables.
ZALO_BOT_TOKEN=
ZALO_ADMIN_CHAT_IDS=
# Optional isolated secondary bot for user booking inquiries only.
# Keep live values in a separate Kubernetes Secret, never in Git.
ZALO_LINH_DAN_BOT_TOKEN=
ZALO_LINH_DAN_CHAT_IDS=
ZALO_LINH_DAN_WEBHOOK_SECRET=
# Third independent Zalo bot (Hoan) - booking inquiries only.
# Never commit real credentials or recipient chat IDs.
ZALO_HOAN_BOT_TOKEN=
ZALO_HOAN_CHAT_IDS=
ZALO_HOAN_WEBHOOK_SECRET=

# Three KTV bots (booking + chat, WITHOUT customer phone/email).
# Keep tokens, webhook secrets and verified chat IDs in Kubernetes Secrets only.
ZALO_TIEN_MANH_BOT_TOKEN=
ZALO_TIEN_MANH_CHAT_IDS=
ZALO_TIEN_MANH_WEBHOOK_SECRET=
ZALO_TUNG_BOT_TOKEN=
ZALO_TUNG_CHAT_IDS=
ZALO_TUNG_WEBHOOK_SECRET=
ZALO_NGUYET_BOT_TOKEN=
ZALO_NGUYET_CHAT_IDS=
ZALO_NGUYET_WEBHOOK_SECRET=
