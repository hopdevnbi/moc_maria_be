NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3001
SWAGGER_ENABLED=true

# Runtime connection. Prefer Session Pooler when the runtime network is IPv4-only.
DATABASE_URL=
# Migration connection. Prefer Direct Connection only when IPv6 is available.
DATABASE_MIGRATION_URL=

DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10

JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_SESSION_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_DOMAIN=

APP_ID=MOC_MARIA
CHAT_TENANT=MOC_MARIA
QUEUE_SOURCE=MOC_MARIA
CHAT_SERVICE_URL=
QUEUE_SERVICE_URL=
# Private server-to-server key for Acutis Queue, never expose to frontend.
QUEUE_API_KEY=
# Internal administrator email recipient for new booking notifications.
ADMIN_ALERT_EMAIL=
# One-time local/operator bootstrap; never commit real values.
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
BOOTSTRAP_SUPER_ADMIN_NAME=
